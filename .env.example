# Veřejné hodnoty Supabase – tyto dvě hodnoty se vloží i do klientského buildu.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUPABASE_ANON_KEY

# Pouze server. Nikdy nepřidávat prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY

# Web Push / VAPID. Dvojici klíčů lze vytvořit příkazem:
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:info@vytahydc.cz
